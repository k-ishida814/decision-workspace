{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dw-popup-spike",
  "version": "0.0.0",
  "identifier": "dev.decision-workspace.popup-spike",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Decision Workspace",
        "width": 480,
        "height": 400,
        "resizable": false,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
