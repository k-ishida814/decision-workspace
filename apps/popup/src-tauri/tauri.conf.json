{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dw-popup",
  "version": "0.0.0",
  "identifier": "dev.decision-workspace.popup",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Decision Workspace",
        "width": 480,
        "height": 320,
        "resizable": false,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
